                    if(promptsEl) {
                        promptsEl.value = state.forms.vm.prompts;
                        const updateCount = () => {
                            const count = promptsEl.value.split('\n').filter(p => p.trim()).length;
                            if(promptCountEl) promptCountEl.innerText = `${count} prompts loaded`;
                        };
                        updateCount();
                        promptsEl.oninput = updateCount;
                    }

                    if(importBtn && fileInput) {
                        importBtn.onclick = () => {
                            if (state.generatedPrompts.length > 0) {
                                const txt = state.generatedPrompts.map(p => p.prompt).join('\n');
                                promptsEl.value = txt;
                                state.forms.vm.prompts = txt;
                                promptCountEl.innerText = `${state.generatedPrompts.length} prompts loaded`;
                                app.toast("Imported prompts from Prompt Engineering", "success");
                            } else {
                                fileInput.click();
                            }
                        };
                        
                        fileInput.onchange = (e) => {
                            const file = e.target.files[0];
                            if (!file) return;
                            const reader = new FileReader();
                            reader.onload = (event) => {
                                const text = event.target.result;
                                if(promptsEl) {
                                    promptsEl.value = text;
                                    state.forms.vm.prompts = text;
                                    const count = text.split('\n').filter(p => p.trim()).length;
                                    if(promptCountEl) promptCountEl.innerText = `${count} prompts loaded`;
                                }
                                app.toast("TXT file imported successfully!", "success");
                            };
                            reader.readAsText(file);
                            fileInput.value = '';
                        };
                    }

                    const btnGen = document.getElementById('btn-generate-images');
                    if (btnGen) {
                        btnGen.onclick = async () => {
                            if (state.isGenerating) return;
                            const prompts = promptsEl.value.split('\n').filter(p => p.trim());
                            if (!prompts.length) return app.toast('Enter prompts first', 'error');
                            
                            const prefix = document.getElementById('vm-prefix') ? document.getElementById('vm-prefix').value : 'Asset';
                            state.queue = prompts.map((p, i) => ({
                                id: app.uuid(), prompt: p, filename: `${prefix}_${app.uuid().substring(0,4)}`, status: 'WAITING', url: null
                            }));
                            
                            this.renderQueue();
                            await this.processQueue();
                        };
                    }
                    this.renderQueue();
                },
                async processQueue() {
                    state.isGenerating = true;
                    document.getElementById('vm-status').innerText = 'GENERATING';
                    
                    const ratioSel = document.getElementById('vm-ratio') ? document.getElementById('vm-ratio').value : '16:9';
                    const ratioCustom = document.getElementById('vm-ratio-custom') ? document.getElementById('vm-ratio-custom').value.trim() : '';
                    const finalRatio = (ratioSel === 'Custom' && ratioCustom) ? ratioCustom : ratioSel;
                    
                    for (let i = 0; i < state.queue.length; i++) {
                        const job = state.queue[i];
                        if (job.status === 'COMPLETE' || job.status === 'FAILED') continue;
                        
                        job.status = 'GENERATING';
                        this.renderQueue();
                        
                        try {
                            const resultUrl = await api.generateImage(job.prompt, finalRatio);
                            job.url = resultUrl;
                            job.status = 'COMPLETE';
                            
                            state.generatedAssets.push({
                                id: job.id, filename: job.filename, url: job.url, prompt: job.prompt, metadata: null, vectorData: null
                            });
                            app.updateAssetBadge();
                        } catch (e) {
                            console.error(e);
                            job.status = 'FAILED';
                        }
                        this.renderQueue();
                    }
                    state.isGenerating = false;
                    document.getElementById('vm-status').innerText = 'COMPLETE';
                    document.getElementById('btn-send-vectorizer').classList.remove('hidden');
                    app.toast("Queue processing complete.", "success");
                },
                renderQueue() {
                    const grid = document.getElementById('vm-queue-grid');
                    if (!grid || !state.queue.length) return;
                    
                    grid.innerHTML = state.queue.map(j => `
                        <div class="bg-dark-card border border-dark-border rounded-lg overflow-hidden flex flex-col">
                            <div class="h-32 bg-dark-bg flex items-center justify-center border-b border-dark-border relative group cursor-pointer" onclick="app.openPreviewById('${j.id}', 'queue')">
                                ${j.url && !j.filename.endsWith('.eps') && !j.filename.endsWith('.svg') ? `<img src="${j.url}" class="w-full h-full object-cover">` : 
                                  j.url && (j.filename.endsWith('.svg') || j.filename.endsWith('.eps')) ? `<div class="flex flex-col items-center justify-center text-brand-500"><i class="ph ph-file-code text-3xl"></i><span class="text-[10px] text-white mt-1">VECTOR READY</span></div>` :
                                  j.status === 'GENERATING' ? `<span class="loader w-6 h-6 border-2"></span>` : 
                                  j.status === 'FAILED' ? `<i class="ph-fill ph-warning-circle text-red-500 text-3xl"></i>` : 
                                  `<i class="ph-thin ph-image text-dark-muted text-3xl"></i>`}
                                ${j.url ? `<div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                     <button type="button" onclick="event.stopPropagation(); event.preventDefault(); app.downloadAssetSafely('${j.id}', 'queue')" class="px-3 py-1.5 bg-brand-500 hover:bg-brand-600 text-white rounded shadow text-[11px] transition-colors flex items-center gap-1.5"><i class="ph ph-download-simple"></i> Download</button>
                                </div>` : ''}
                            </div>
                            <div class="p-2">
                                <p class="text-[10px] font-mono text-dark-muted truncate">${j.filename}</p>
                                <span class="text-[9px] px-1.5 py-0.5 rounded font-bold ${j.status==='COMPLETE'?'bg-green-900/30 text-green-500':j.status==='FAILED'?'bg-red-900/30 text-red-500':'bg-dark-panel text-dark-muted'} mt-1 inline-block">${j.status}</span>
                            </div>
                        </div>
                    `).join('');
                }
            },
            
            vectorize: {
                init() {
                    this.renderQueue();
                    const newAssets = state.generatedAssets.filter(a => !state.vectorQueue.some(vq => vq.id === a.id));
                    if(newAssets.length > 0) {
                        newAssets.forEach(a => {
                            state.vectorQueue.push({ id: a.id, filename: a.filename, originalUrl: a.url, status: 'WAITING', svgData: null });
                        });
                        this.renderQueue();
                    }

                    const startBtn = document.getElementById('btn-start-vector');
                    if (startBtn) {
                        startBtn.onclick = async () => {
                            if(state.isVectorizing) return;
                            const jobs = state.vectorQueue.filter(j => j.status !== 'COMPLETED');
                            if(jobs.length === 0) return app.toast("No pending files", "info");

                            state.isVectorizing = true;
                            const consoleEl = document.getElementById('vp-console');
                            const progressText = document.getElementById('vp-progress-text');
                            
                            if (progressText) progressText.innerText = 'TRACING VECTORS...';
                            
                            for (let job of jobs) {
                                try {
                                    job.status = 'VECTORIZING';
                                    this.renderQueue();
                                    if (consoleEl) {
                                        consoleEl.innerHTML += `<br>> ImageTracer tracing paths for ${job.filename}...`;
                                        consoleEl.scrollTop = consoleEl.scrollHeight;
                                    }
                                    
                                    await new Promise((resolve, reject) => {
                                        const img = new Image();
                                        img.crossOrigin = "Anonymous";
                                        img.onload = () => {
                                            try {
                                                const options = {
                                                    ltres: 1,
                                                    qtres: 1,
                                                    pathomit: 8,
                                                    rightangleenhance: true,
                                                    colorsampling: 2,
                                                    numberofcolors: 16,
                                                    mincolorratio: 0.02,
                                                    colorquantcycles: 3,
                                                    scale: 1,
                                                    blurradius: 0,
                                                    blurdelta: 20
                                                };
                                                
                                                ImageTracer.imageToSVG(img.src, (svgstr) => {
                                                    job.svgData = svgstr;
                                                    resolve();
                                                }, options);
                                            } catch (err) {
                                                reject(err);
                                            }
                                        };
                                        img.onerror = (err) => reject(err);
                                        img.src = job.originalUrl;
                                    });
                                    
                                    job.status = 'COMPLETED';
                                    this.renderQueue();
                                    if (consoleEl) {
                                        consoleEl.innerHTML += `<br><span class="text-green-500">> Vector Success: ${job.filename} (True Vector SVG & EPS ready)</span>`;
                                        consoleEl.scrollTop = consoleEl.scrollHeight;
                                    }
                                } catch(e) {
                                    console.error(e);
                                    job.status = 'ERROR';
                                    if (consoleEl) {
                                        consoleEl.innerHTML += `<br><span class="text-red-500">> Error tracing ${job.filename}</span>`;
                                    }
                                }
                            }
                            state.isVectorizing = false;
                            if (progressText) progressText.innerText = 'COMPLETE';
                            app.toast("True vectorization complete", "success");
                            document.getElementById('btn-vp-to-meta').classList.remove('hidden');
                            document.getElementById('btn-vp-to-meta').onclick = () => app.navigate('metadata');
                        };
                    }

                    const saveZipBtn = document.getElementById('btn-vp-save-outputs');
                    if (saveZipBtn) {
                        saveZipBtn.onclick = async () => {
                            const completedJobs = state.vectorQueue.filter(j => j.status === 'COMPLETED');
                            if (completedJobs.length === 0) {
                                return app.toast("Please run 'Start Batch Conversion' first to generate vector paths.", "error");
                            }

                            app.toast("Preparing True Vector ZIP archive...", "info");
                            const zip = new JSZip();

                            for (let job of completedJobs) {
                                const baseName = job.filename.replace(/\.[^/.]+$/, "");
                                
                                if (job.originalUrl) {
                                    const blobPng = app.base64ToBlob(job.originalUrl.split(',')[1], job.originalUrl.split(';')[0].split(':')[1]);
                                    zip.file(`${baseName}.png`, blobPng);
                                }

                                if (job.svgData) {
                                    zip.file(`${baseName}.svg`, job.svgData);
                                    
                                    const epsContent = `%PS-Adobe-3.0 EPSF-3.0
%%Title: ${baseName}.eps
%%Creator: ASCAstock Production Vector Engine
%%BoundingBox: 0 0 800 600
%%DocumentProcessColors: Cyan Magenta Yellow Black
%%EndComments
%%BeginProlog
/svgpath { newpath } def
%%EndProlog
%%Page: 1 1
%%BeginPageSetup
%%EndPageSetup
gsave
${job.svgData.replace(/<svg[^>]*>/g, '').replace(/<\/svg>/g, '')}
grestore
showpage
%%EOF`;
                                    zip.file(`${baseName}.eps`, epsContent);
                                }
                            }

                            try {
                                const content = await zip.generateAsync({ type: "blob" });
                                app.downloadBlob(content, `ASCA_TrueVectors_${Date.now()}.zip`);
                                app.toast("True Vector ZIP downloaded successfully!", "success");
                            } catch (err) {
                                console.error(err);
                                app.toast("Failed to create ZIP archive.", "error");
                            }
                        };
                    }
                },
                renderQueue() {
                    const grid = document.getElementById('vp-queue-grid');
                    if(!grid || state.vectorQueue.length === 0) return;
                    
                    grid.innerHTML = state.vectorQueue.map(job => `
                        <div class="bg-dark-card border border-dark-border rounded-lg p-3 flex items-center gap-4">
                            <div class="w-16 h-16 bg-dark-bg rounded border border-dark-border overflow-hidden flex-shrink-0">
                                <img src="${job.originalUrl}" class="w-full h-full object-cover opacity-75">
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-xs text-white font-mono truncate">${job.filename}</p>
                                <span class="text-[10px] px-2 py-0.5 rounded font-bold ${job.status === 'COMPLETED' ? 'bg-green-900/30 text-green-500' : 'bg-dark-panel text-dark-muted'} mt-1 inline-block">${job.status}</span>
                            </div>
                        </div>
                    `).join('');
                }
            },
            
            metadata: {
                init() {
                    this.renderTable();
                    document.getElementById('btn-optimize-all').onclick = async () => {
                        const assets = state.generatedAssets.filter(a => !a.metadata);
                        if(assets.length === 0) return app.toast("No assets to optimize", "info");
                        
                        const btn = document.getElementById('btn-optimize-all');
                        btn.innerHTML = '<span class="loader w-4 h-4 border-2"></span> Optimizing...';
                        
                        for (let asset of assets) {
                            try {
                                const meta = await api.analyzeImage(asset.url, `Generate microstock metadata (Title max 100 char, Description, Keywords array).`, { type: "OBJECT", properties: { title: { type: "STRING" }, description: { type: "STRING" }, keywords: { type: "ARRAY", items: { type: "STRING" } } } });
                                asset.metadata = meta;
                                this.renderTable();
                            } catch (e) {
                                asset.metadata = { error: true };
                            }
                        }
                        btn.innerHTML = '<i class="ph-bold ph-magic-wand"></i> Optimize';
                        app.toast("Metadata optimization complete", "success");
                        document.getElementById('btn-export-csv').disabled = false;
                        document.getElementById('btn-export-csv').classList.remove('opacity-50', 'cursor-not-allowed');
                    };

                    document.getElementById('btn-export-csv').onclick = () => {
                        const ready = state.generatedAssets.filter(a => a.metadata && !a.metadata.error);
                        if(ready.length === 0) return;
                        const header = "Filename,Title,Description,Keywords\n";
                        const rows = ready.map(a => `${a.filename},"${a.metadata.title}","${a.metadata.description}","${a.metadata.keywords.join(', ')}"`).join('\n');
                        app.downloadBlob(new Blob([header + rows], { type: 'text/csv' }), 'Metadata.csv');
                    };
                },
                renderTable() {
                    const tbody = document.getElementById('md-table-body');
                    if(state.generatedAssets.length === 0) return;
                    
                    tbody.innerHTML = state.generatedAssets.map(asset => {
                        const hasMeta = asset.metadata && !asset.metadata.error;
                        return `
                        <tr class="border-b border-dark-border hover:bg-dark-panel">
                            <td class="py-3">
                                <div class="w-12 h-12 bg-dark-bg border border-dark-border rounded overflow-hidden">
                                    <img src="${asset.url}" class="w-full h-full object-cover">
                                </div>
                            </td>
                            <td class="py-3 pr-4 group w-32 max-w-[150px]">
                                <div class="flex items-start justify-between gap-1">
                                    <div class="font-mono text-[10px] text-dark-muted truncate" id="meta-filename-${asset.id}">${asset.filename}</div>
                                    <div class="flex opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
                                        <button onclick="app.copyText(document.getElementById('meta-filename-${asset.id}').innerText)" class="p-1 text-brand-500 hover:text-white" title="Copy"><i class="ph ph-copy"></i></button>
                                        <button onclick="app.renameFromMetadata('${asset.id}')" class="p-1 text-brand-500 hover:text-white" title="Auto Rename from Title"><i class="ph ph-magic-wand"></i></button>
                                        <button onclick="app.editMeta('${asset.id}', 'filename')" class="p-1 text-brand-500 hover:text-white" title="Edit Filename"><i class="ph ph-pencil"></i></button>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 pr-4">
                                ${hasMeta ? `
                                    <div class="text-[11px] text-white font-medium mb-1 line-clamp-2">${asset.metadata.title}</div>
                                    <div class="text-[9px] text-dark-muted line-clamp-2">${asset.metadata.description || '-'}</div>
                                ` : '-'}
                            </td>
                            <td class="py-3 pr-4 group">
                                ${hasMeta ? `
                                    <div class="flex items-start justify-between gap-2">
                                        <div class="text-[9px] text-dark-muted max-w-[200px] truncate" id="meta-keys-${asset.id}">${asset.metadata.keywords.join(', ')}</div>
                                        <div class="flex opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
                                            <button onclick="app.copyText(document.getElementById('meta-keys-${asset.id}').innerText)" class="p-1 text-brand-500 hover:text-white" title="Copy"><i class="ph ph-copy"></i></button>
                                            <button onclick="app.editMeta('${asset.id}', 'keys')" class="p-1 text-brand-500 hover:text-white" title="Edit"><i class="ph ph-pencil"></i></button>
                                        </div>
                                    </div>
                                ` : '-'}
                            </td>
                            <td class="py-3">
                                ${hasMeta ? `<span class="text-[10px] text-green-500 font-bold">READY</span>` : `<span class="text-[10px] text-dark-muted font-bold">WAITING</span>`}
                            </td>
                        </tr>
                    `}).join('');
                }
            },
            
            assets: {
                init() {
                    const grid = document.getElementById('assets-grid');
                    if(state.generatedAssets.length === 0) {
                        grid.innerHTML = `<div class="col-span-full py-20 text-center text-dark-muted">No assets generated yet.</div>`;
                        return;
                    }
                    
                    grid.innerHTML = state.generatedAssets.map(a => `
                        <div class="bg-dark-card border border-dark-border rounded-lg overflow-hidden flex flex-col group">
                            <div class="h-32 relative cursor-pointer" onclick="app.openPreviewById('${a.id}', 'assets')">
                                <img src="${a.url}" class="w-full h-full object-cover">
                                <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                     <button type="button" onclick="event.stopPropagation(); event.preventDefault(); app.downloadAssetSafely('${a.id}', 'assets')" class="px-3 py-1.5 bg-brand-500 hover:bg-brand-600 text-white rounded shadow text-[11px] transition-colors flex items-center gap-1.5"><i class="ph ph-download-simple"></i> Download</button>
                                </div>
                            </div>
                            <div class="p-2">
                                <p class="text-[10px] font-mono text-dark-muted truncate">${a.filename}</p>
                            </div>
                        </div>
                    `).join('');
                }
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            app.init();
            app.updateAssetBadge();
        });

    </script>
</body>
</html>
