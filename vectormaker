    <script>
        /**
         * ASCASTOCK PRODUCTION - Core Application Logic
         */

        const CONFIG = {
            API_KEY: typeof CANVAS_API_KEY !== 'undefined' ? CANVAS_API_KEY : (window.GEMINI_API_KEY || ""), 
            MODELS: {
                TEXT: 'gemini-3-flash-preview',
                VISION: 'gemini-3-flash-preview', 
                IMAGE: 'gemini-3.1-flash-image'   
            }
        };

        const state = {
            currentView: 'landing',
            generatedPrompts: [],
            generatedAssets: [], 
            queue: [],            
            vectorQueue: [],      
            isGenerating: false,
            isVectorizing: false,
            styles: ['Automatic', 'Flat Vector', 'Minimal', 'Geometric', 'Isometric', 'Line Art', 'Outline', 'Hand Drawn', 'Corporate', '3D', 'Papercut', 'Sticker', 'Icon', 'Infographic', 'Custom'],
            palettes: ['Automatic', 'Quiet Luxury', 'Eco-Futurism', 'Digital Lavender', 'Warm Industrial'],
            
            research: {
                ideaBank: [],
                trend: { results: null },
                event: { results: null },
                calendar: { plans: null }
            },
            
            eventState: {
                currentTab: 'events',
                events: [],
                concepts: [],
                prompts: [],
                selectedEventIds: [],
                selectedConceptIds: []
            },
            
            forms: {
                pe: { idea: '', consistency: 'Balanced', complexity: 'Medium', style: 'Automatic', bg: 'Automatic', palette: 'Automatic', trend: 'Automatic', ip: true, unique: false, qty: '1' },
                vm: { prompts: '', faceless: false, consistent: true, format: 'PNG (HQ)', ratio: '16:9', prefix: 'Asset' },
                vp: { preset: 'microstock', transparency: true, simplify: '1.0', curve: '1.5', noise: '0', scale: '4', platform: 'all' },
                md: { format: 'EPS' },
                calendar: { niche: '', assetType: 'Vector Illustration', vectorStyle: 'Flat Design Vector Illustration', promptMode: 'Standard Prompt', count: '20' },
                event: { location: 'Global / International', month: 'October', year: '2026', category: 'Automatic', style: 'Flat Illustration', bg: 'White Background', qty: '5', noText: true }
            }
        };

        const api = {
            async generateStructuredText(prompt, schema) {
                if (!prompt) return null;
                
                const apiKey = CONFIG.API_KEY || (typeof window.getApiKey === 'function' ? window.getApiKey() : '');
                
                const payload = {
                    contents: [{ parts: [{ text: prompt }] }],
                    generationConfig: {
                        responseMimeType: "application/json",
                        responseSchema: schema
                    }
                };
                
                try {
                    const url = `https://generativelanguage.googleapis.com/v1beta/models/${CONFIG.MODELS.TEXT}:generateContent?key=${apiKey}`;
                    const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                
                const responseText = await response.text();
                if (!response.ok) {
                    let errMsg = `HTTP ${response.status}: `;
                    try {
                        const err = JSON.parse(responseText);
                        errMsg += err.error?.message || err.message || JSON.stringify(err);
                    } catch(e) {
                        errMsg += responseText.slice(0, 100);
                    }
                    throw new Error(errMsg || 'Unknown API Error');
                }
                
                const result = JSON.parse(responseText);
                const jsonText = result.candidates[0].content.parts[0].text;
                return JSON.parse(jsonText);
            } catch (error) {
                console.error("Text Gen Error:", error);
                    app.toast("AI Generation Failed: " + error.message, "error");
                    throw error;
                }
            },

            async generateImage(prompt, aspectRatio = "1:1") {
                const apiKey = CONFIG.API_KEY || (typeof window.getApiKey === 'function' ? window.getApiKey() : '');
                let finalError = "Failed to generate image.";
                
                try {
                    const payload1 = {
                        contents: [{ role: 'user', parts: [{ text: prompt }] }],
                        generationConfig: {
                            responseModalities: ['IMAGE'],
                            imageConfig: { aspectRatio: aspectRatio }
                        }
                    };
                    const url1 = `https://generativelanguage.googleapis.com/v1beta/models/${CONFIG.MODELS.IMAGE}:generateContent?key=${apiKey}`;
                    const response1 = await fetch(url1, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload1)
                    });

                    if (response1.ok) {
                        const result1 = JSON.parse(await response1.text());
                        const part = result1?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
                        if (part?.inlineData) {
                            return `data:${part.inlineData.mimeType};base64,${part.inlineData.data}`;
                        }
                    } else {
                        const errText = await response1.text();
                        try { finalError = JSON.parse(errText).error?.message || finalError; } catch(e){}
                    }
                } catch (e) {
                    console.warn("Attempt 1 failed, trying fallback...", e);
                }

                try {
                    const payload2 = {
                        instances: [{ prompt: prompt }],
                        parameters: { sampleCount: 1, aspectRatio: aspectRatio }
                    };
                    const url2 = `https://generativelanguage.googleapis.com/v1beta/models/imagen-3.0-generate-001:predict?key=${apiKey}`;
                    
                    const response2 = await fetch(url2, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload2)
                    });
                    
                    const responseText2 = await response2.text();
                    
                    if (!response2.ok) {
                        try { const err = JSON.parse(responseText2); finalError = err.error?.message || finalError; } catch(e) {}
                        throw new Error(finalError);
                    }
                    
                    const result2 = JSON.parse(responseText2);
                    if (result2.predictions && result2.predictions[0] && result2.predictions[0].bytesBase64Encoded) {
                        return `data:image/png;base64,${result2.predictions[0].bytesBase64Encoded}`;
                    } else {
                        throw new Error("No image data returned from provider.");
                    }
                } catch (error) {
                    console.error("Image Gen Error:", error);
                    throw error;
                }
            },

            async analyzeImage(base64Data, instructions, schema) {
                const apiKey = CONFIG.API_KEY || (typeof window.getApiKey === 'function' ? window.getApiKey() : '');
                
                const base64Clean = base64Data.split(',')[1];
                const mimeType = base64Data.split(';')[0].split(':')[1];
                
                const payload = {
                    contents: [{
                        role: "user",
                        parts: [
                            { text: instructions },
                            { inlineData: { mimeType: mimeType, data: base64Clean } }
                        ]
                    }],
                    generationConfig: {
                        responseMimeType: "application/json",
                        responseSchema: schema
                    }
                };

                try {
                    const url = `https://generativelanguage.googleapis.com/v1beta/models/${CONFIG.MODELS.VISION}:generateContent?key=${apiKey}`;
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    
                    const responseText = await response.text();
                    if (!response.ok) {
                        let errMsg = 'Vision API Error';
                        try { const err = JSON.parse(responseText); errMsg = err.error?.message || errMsg; } catch(e) {}
                        throw new Error(errMsg);
                    }
                    if (!responseText) throw new Error("Empty response from Vision API");
                    
                    const result = JSON.parse(responseText);
                    return JSON.parse(result.candidates[0].content.parts[0].text);
                } catch (error) {
                    console.error("Vision Error:", error);
                    app.toast("Metadata Analysis Failed", "error");
                    throw error;
                }
            }
        };

        const app = {
            init() {
                const savedUser = localStorage.getItem('asca_user_id') || 'ASCA';
                const savedPass = localStorage.getItem('asca_password') || '109080';
                window._currentUserId = savedUser;
                window._currentPassword = savedPass;

                const remembered = localStorage.getItem('asca_remember');
                if (remembered === 'true') {
                    document.getElementById('accessGateModal').classList.add('hidden');
                    this.navigate('landing');
                } else {
                    document.getElementById('accessGateModal').classList.remove('hidden');
                }
                
                const mobileMenuBtn = document.getElementById('mobileMenuBtn');
                if (mobileMenuBtn) {
                    mobileMenuBtn.addEventListener('click', () => {
                        const nav = document.getElementById('navMenu');
                        if (nav) nav.classList.toggle('hidden');
