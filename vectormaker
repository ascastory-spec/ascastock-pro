                        const asset = state.generatedAssets.find(a => a.id === id);
                        if(asset) {
                            if(field === 'filename') {
                                asset.filename = el.innerText.trim();
                            } else if(asset.metadata) {
                                if(field === 'title') asset.metadata.title = el.innerText;
